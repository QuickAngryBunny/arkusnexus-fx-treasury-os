# Copy to workers/python/.env (git-ignored). Values already set in the environment win.
# Banxico SIE API token: https://www.banxico.org.mx/SieAPIRest/service/v1/token
BANXICO_TOKEN=
# Raw store: defaults to local Azurite (docker compose). Set a directory instead to skip Blob entirely:
# FX_RAW_STORE_DIR=.raw-store
# FX_RAW_STORE_CONNECTION=<Azure Storage connection string>
# FX_RAW_STORE_CONTAINER=raw-rates
